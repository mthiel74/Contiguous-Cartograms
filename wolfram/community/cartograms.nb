 ShowCellLabel->False,ExpressionUUID->"1ce2159c-fad6-4656-ba14-ebc233a2186f"],

Cell[TextData[{
 StyleBox["CartogramDistortionGrid[cart]", "Input"],
 " returns the ",
 StyleBox["Line", "Input"],
 " primitives for the warped grid; wrap in ",
 StyleBox["Graphics", "Input"],
 " to draw, overlay on a ",
 StyleBox["WorldCartogram", "Input"],
 " result to annotate a cartogram with its own distortion field."
}], "Text",ExpressionUUID->"0234bbf0-436c-4b05-b26a-a36421b5c202"],

Cell["7. Bringing your own data", "Section",ExpressionUUID->"aaceef05-c1e2-45de-9405-6446d040ee1d"],

Cell[TextData[{
 "Any ",
 StyleBox["Association", "Input"],
 " of country-identifier \[RightArrow] value works in place of a metric \
string. Keys may be ",
 StyleBox["CountryData", "Input"],
 " identifiers (e.g. ",
 StyleBox["\"UnitedStates\"", "Input"],
 ") or display names (",
 StyleBox["\"United States\"", "Input"],
 ")."
}], "Text",ExpressionUUID->"dd4f7a1a-45c6-485f-8783-72fb2d0dc80d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g20", " ", "=", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<UnitedStates\>\"", " ", "->", " ", "332."}], ",", " ", 
      RowBox[{"\"\<China\>\"", " ", "->", " ", "1425."}], ",", " ", "\n", 
      "        ", 
      RowBox[{"\"\<India\>\"", " ", "->", " ", "1428."}], ",", " ", 
      RowBox[{"\"\<Japan\>\"", " ", "->", " ", "125."}], ",", " ", 
      RowBox[{"\"\<Germany\>\"", " ", "->", " ", "83."}], ",", " ", "\n", 
      "        ", 
      RowBox[{"\"\<UnitedKingdom\>\"", " ", "->", " ", "67."}], ",", " ", 
      RowBox[{"\"\<France\>\"", " ", "->", " ", "67.5"}], ",", " ", "..."}], 
     "|>"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"WorldCartogram", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<G20 population (millions)\>\"", ",", " ", "g20"}], "}"}], ",",
    "\n", "   ", 
   RowBox[{"\"\<MissingCountries\>\"", " ", "->", " ", "\"\<ShowGrey\>\""}]}],
   "]"}]}], "Input",ExpressionUUID->"9fceb267-b978-4ee5-b211-47e8bc53f0c0"],

