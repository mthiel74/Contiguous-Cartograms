Cell[TextData[{
 "Set ",
 StyleBox["\"Background\" -> \"Satellite\"", "Input"],
 " and each country is textured with the corresponding patch of Wolfram's ",
 StyleBox["GeoBackground -> \"Satellite\"", "Input"],
 " imagery. On the cartogram side the imagery is deformed along with the \
country geometry, giving an effect similar to a shaded-relief globe being \
inflated or deflated locally."
}], "Text",ExpressionUUID->"aac0bae4-9604-42c1-a60a-111eb25222ad"],

Cell[BoxData[
 RowBox[{"WorldCartogram", "[", 
  RowBox[{"\"\<GDP\>\"", ",", " ", 
   RowBox[{"\"\<Background\>\"", " ", "->", " ", "\"\<Satellite\>\""}]}], 
  "]"}]], "Input",ExpressionUUID->"fcd2b6cc-3e7f-4c05-b094-c16caba45bed"],

