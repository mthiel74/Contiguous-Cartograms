    {
     PaneBox[
      StyleBox["\<\"Figure 1. Left: countries on the geographic lon/lat grid, \
each textured with satellite imagery. Right: the same countries with area \
proportional to GDP, the satellite imagery deformed along with the geometry. \
Ocean area is preserved.\"\>",
       StripOnInput->False,
