        "], {{0, 389.28}, {1800., 0}}, {0, 255},
        ColorFunction->RGBColor,
        ImageResolution->{150, 150}],
       BoxForm`ImageTag[
       "Byte", ColorSpace -> "RGB", Interleaving -> True, Magnification -> 
        Automatic, 
        MetaInformation -> <|
         "Exif" -> <|
           "ImageWidth" -> 3750, "ImageLength" -> 811, "XResolution" -> 150, 
            "YResolution" -> 150, "ResolutionUnit" -> "Inch", "Software" -> 
