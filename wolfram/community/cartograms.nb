 CellMargins->{{0, 0}, {10, 14}},
 ShowCellLabel->False,ExpressionUUID->"30f45008-6721-4ede-99a5-e2653b2b58d8"],

Cell["\<\
For reference, here is the full US ring set drawn on a plain geographic frame \
\[LongDash] 28 mainland rings on the right, Alaska mainland and its 77 \
Aleutian-island rings in the upper left, and 8 Hawaiian islands in the lower \
left:\
\>", "Text",ExpressionUUID->"2a165efc-e252-48f2-8d82-2d77e0617d01"],

