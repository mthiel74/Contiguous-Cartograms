 ShowCellLabel->False,ExpressionUUID->"0e671160-55b2-4969-8ff5-c5e6c14647bc"],

Cell[TextData[{
 StyleBox["CartogramDistortionGrid[cart]", "Input"],
 " returns the ",
 StyleBox["Line", "Input"],
 " primitives for the warped grid; wrap in ",
 StyleBox["Graphics", "Input"],
 " to draw, overlay on a ",
 StyleBox["WorldCartogram", "Input"],
 " result to annotate a cartogram with its own distortion field."
}], "Text",ExpressionUUID->"0a8ea8e7-6554-43b0-8819-9dc6df0402b9"],

Cell["7. Bringing your own data", "Section",ExpressionUUID->"d4267bdf-cd95-4569-b5a7-47f279005fab"],

Cell[TextData[{
 "Any ",
 StyleBox["Association", "Input"],
 " of country-identifier \[RightArrow] value works in place of a metric \
string. Keys may be ",
 StyleBox["CountryData", "Input"],
 " identifiers (e.g. ",
 StyleBox["\"UnitedStates\"", "Input"],
 ") or display names (",
 StyleBox["\"United States\"", "Input"],
 ")."
}], "Text",ExpressionUUID->"efabe1ed-5e1a-48ac-879f-9192a75b5116"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g20", " ", "=", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<UnitedStates\>\"", " ", "->", " ", "332."}], ",", " ", 
      RowBox[{"\"\<China\>\"", " ", "->", " ", "1425."}], ",", " ", "\n", 
      "        ", 
      RowBox[{"\"\<India\>\"", " ", "->", " ", "1428."}], ",", " ", 
      RowBox[{"\"\<Japan\>\"", " ", "->", " ", "125."}], ",", " ", 
      RowBox[{"\"\<Germany\>\"", " ", "->", " ", "83."}], ",", " ", "\n", 
      "        ", 
      RowBox[{"\"\<UnitedKingdom\>\"", " ", "->", " ", "67."}], ",", " ", 
      RowBox[{"\"\<France\>\"", " ", "->", " ", "67.5"}], ",", " ", "..."}], 
     "|>"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"WorldCartogram", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<G20 population (millions)\>\"", ",", " ", "g20"}], "}"}], ",",
    "\n", "   ", 
   RowBox[{"\"\<MissingCountries\>\"", " ", "->", " ", "\"\<ShowGrey\>\""}]}],
   "]"}]}], "Input",ExpressionUUID->"26cdd907-a9d3-48be-9f82-2e0febc3a099"],

