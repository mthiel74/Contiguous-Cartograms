 ShowCellLabel->False,ExpressionUUID->"10819059-eeff-450e-9378-1b1b319ad520"],

Cell[TextData[{
 StyleBox["CartogramDistortionGrid[cart]", "Input"],
 " returns the ",
 StyleBox["Line", "Input"],
 " primitives for the warped grid; wrap in ",
 StyleBox["Graphics", "Input"],
 " to draw, overlay on a ",
 StyleBox["WorldCartogram", "Input"],
 " result to annotate a cartogram with its own distortion field."
}], "Text",ExpressionUUID->"2137499d-4cb9-444f-a3df-0a42a5570b4e"],

Cell["7. Bringing your own data", "Section",ExpressionUUID->"9a3eac8e-fa6c-4bcf-bcda-5266ca2295a1"],

Cell[TextData[{
 "Any ",
 StyleBox["Association", "Input"],
 " of country-identifier \[RightArrow] value works in place of a metric \
string. Keys may be ",
 StyleBox["CountryData", "Input"],
 " identifiers (e.g. ",
 StyleBox["\"UnitedStates\"", "Input"],
 ") or display names (",
 StyleBox["\"United States\"", "Input"],
 ")."
}], "Text",ExpressionUUID->"5369d8e9-a298-4dc4-a254-0675540fb02a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g20", " ", "=", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<UnitedStates\>\"", " ", "->", " ", "332."}], ",", " ", 
      RowBox[{"\"\<China\>\"", " ", "->", " ", "1425."}], ",", " ", "\n", 
      "        ", 
      RowBox[{"\"\<India\>\"", " ", "->", " ", "1428."}], ",", " ", 
      RowBox[{"\"\<Japan\>\"", " ", "->", " ", "125."}], ",", " ", 
      RowBox[{"\"\<Germany\>\"", " ", "->", " ", "83."}], ",", " ", "\n", 
      "        ", 
      RowBox[{"\"\<UnitedKingdom\>\"", " ", "->", " ", "67."}], ",", " ", 
      RowBox[{"\"\<France\>\"", " ", "->", " ", "67.5"}], ",", " ", "..."}], 
     "|>"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"WorldCartogram", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<G20 population (millions)\>\"", ",", " ", "g20"}], "}"}], ",",
    "\n", "   ", 
   RowBox[{"\"\<MissingCountries\>\"", " ", "->", " ", "\"\<ShowGrey\>\""}]}],
   "]"}]}], "Input",ExpressionUUID->"daaa0320-956d-4e27-b2bb-eec10bbc4a0e"],

