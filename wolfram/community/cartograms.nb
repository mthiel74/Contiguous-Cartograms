    {
     PaneBox[
      StyleBox["\<\"Figure 2. Left: geographic frame, regular 15\[Degree] \
grid in red, countries grey. Right: the GDP cartogram, the same grid now \
warped by the same diffusion flow. Grid cells over high-wealth regions shrink \
(fewer dollars per square millimetre); cells over oceans and sparsely \
populated continents stretch.\"\>",
       StripOnInput->False,
       FontFamily->"Helvetica",
       FontSize->10,
       FontSlant->Italic],
      Alignment->Center,
      ImageSize->680]}
   },
   DefaultBaseStyle->"Column",
