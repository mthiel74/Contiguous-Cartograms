Cell["3. Getting the current version", "Section",ExpressionUUID->"1497b97e-f742-4c18-be33-9b14ac243e82"],

Cell[TextData[{
 "The package is a single ",
 StyleBox[".wl", "Input"],
 " file with no external dependencies \[LongDash] pure Wolfram Language. The \
simplest way to try it right now is to download the file directly from GitHub \
and ",
 StyleBox["Get", "Input"],
 " it:"
}], "Text",ExpressionUUID->"7254588b-b3be-4cd6-82f6-063820c4aa28"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "url", "  ", "=", 
   " ", "\"\<https://raw.githubusercontent.com/mthiel74/Contiguous-Cartograms/\
main/wolfram/CartogramWL/CartogramWL.wl\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"path", " ", "=", " ", 
   RowBox[{"URLDownload", "[", "url", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Get", "[", "path", "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Built", "-", 
    RowBox[{"in", " ", "metric"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"WorldCartogram", "[", "\"\<Population\>\"", "]"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Custom", " ", "colour", " ", "scheme"}], " ", "+", " ", 
    RowBox[{"satellite", " ", "background"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"WorldCartogram", "[", 
   RowBox[{"\"\<GDP\>\"", ",", "\n", "  ", 
    RowBox[{"\"\<ColorFunction\>\"", " ", "->", " ", 
     RowBox[{"ColorData", "[", "\"\<TemperatureMap\>\"", "]"}]}], ",", "\n", 
    "  ", 
    RowBox[{"\"\<Background\>\"", "    ", "->", " ", "\"\<Satellite\>\""}]}], 
   "]"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Your", " ", "own", " ", "data", " ", "as", " ", "an", " ", 
    "Association"}], " ", "*)"}]}], "\n", 
 RowBox[{"WorldCartogram", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<my metric\>\"", ",", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Germany\>\"", " ", "->", " ", "83."}], ",", " ", 
       RowBox[{"\"\<France\>\"", " ", "->", " ", "67.5"}], ",", " ", "..."}], 
      "|>"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"\"\<MissingCountries\>\"", " ", "->", " ", "\"\<ShowGrey\>\""}]}],
   "]"}]}], "Input",ExpressionUUID->"bea62cf3-ee1c-4084-ba52-c050e6f1d8df"],

Cell[TextData[{
 "That is one call to ",
 StyleBox["URLDownload", "Input"],
 " followed by one call to ",
 StyleBox["Get", "Input"],
 "; no paclet registration, no git clone, nothing to install. After that all \
the public symbols (",
 StyleBox["WorldCartogram", "Input"],
 ", ",
 StyleBox["CartogramDistortionGrid", "Input"],
 ", ",
 StyleBox["CountryPolygonRings", "Input"],
 ", and the low-level primitives ",
 StyleBox["DiffusionSolver", "Input"],
 ", ",
 StyleBox["AdvectPoints", "Input"],
 ", ",
 StyleBox["Cartogram", "Input"],
 ", ",
 StyleBox["CartogramTransform", "Input"],
 ", ",
 StyleBox["RasterizePolygons", "Input"],
 ") live in the ",
 StyleBox["CartogramWL`", "Input"],
 " context. ",
 StyleBox["?WorldCartogram", "Input"],
 " prints the full option list."
}], "Text",ExpressionUUID->"2fbb4b31-5b6e-4b25-91bf-9f561207dae6"],

Cell[TextData[{
 "Power users who want the examples, the test suite, the experimental \
benchmark sandbox, or the Python twin can clone the repository: ",
 ButtonBox["https://github.com/mthiel74/Contiguous-Cartograms",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/mthiel74/Contiguous-Cartograms"], None}],
 "."
}], "Text",ExpressionUUID->"a395574a-e52e-4fda-a8ca-e99f4578a4a3"],

Cell["4. Documentation links", "Section",ExpressionUUID->"4b657570-2085-4e2f-b021-ef89a9a94cc8"],

Cell[TextData[{
 StyleBox["\[Bullet] ",
  FontWeight->Bold],
 ButtonBox["Wolfram section of the repository README",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/mthiel74/Contiguous-Cartograms#wolfram-language-\
implementation"], None}],
 " \[LongDash] headline figure, one-line call, full option table \
(ColorFunction, Background, MissingCountries, PerformanceGoal, \[Ellipsis]), \
and inline examples. Written for a general Wolfram user and probably the best \
single entry point if you have just arrived here.\n",
 StyleBox["\[Bullet] ",
  FontWeight->Bold],
 ButtonBox["wolfram/README.md",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/mthiel74/Contiguous-Cartograms/blob/main/wolfram/\
README.md"], None}],
 " \[LongDash] API cheat sheet, algorithm notes, grid conventions, and the \
mapping between the Wolfram and Python entry points.\n",
 StyleBox["\[Bullet] ",
  FontWeight->Bold],
 ButtonBox["wolfram/CartogramWL/CartogramWL.wl",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/mthiel74/Contiguous-Cartograms/blob/main/wolfram/\
CartogramWL/CartogramWL.wl"], None}],
 " \[LongDash] the package source, ~700 lines of commented Wolfram Language. \
The direct raw-file link used above is: ",
 ButtonBox["https://raw.githubusercontent.com/mthiel74/Contiguous-Cartograms/\
main/wolfram/CartogramWL/CartogramWL.wl",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://raw.githubusercontent.com/mthiel74/Contiguous-Cartograms/\
main/wolfram/CartogramWL/CartogramWL.wl"], None}],
 ".\n",
 StyleBox["\[Bullet] ",
  FontWeight->Bold],
 ButtonBox["wolfram/community/cartograms.nb",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/mthiel74/Contiguous-Cartograms/blob/main/wolfram/\
community/cartograms.nb"], None}],
 " \[LongDash] the main walkthrough notebook that this note comments on.\n",
 StyleBox["\[Bullet] ",
  FontWeight->Bold],
 ButtonBox["the wolfram/ subtree on GitHub",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/mthiel74/Contiguous-Cartograms/tree/main/wolfram"]\
, None}],
 " \[LongDash] examples (",
 StyleBox["world.wls", "Input"],
 ", ",
 StyleBox["world_metric.wls", "Input"],
 ", ",
 StyleBox["distortion_grid.wls", "Input"],
 ", ",
 StyleBox["alaska_before_after.wls", "Input"],
 "), the 7-case regression suite, and the experimental benchmark sandbox that \
records what was measured and what did or did not pay off."
}], "Text",ExpressionUUID->"3e4c4207-f6a6-43b8-a92d-4e411c3ebf84"],

Cell[TextData[{
 "Feedback, bug reports and PRs all welcome on GitHub. If you spot a country \
whose ",
 StyleBox["CountryData", "Input"],
 " polygon is incomplete in the same way the US was, the fix is one line in \
",
 StyleBox["extraCountryRings", "Input"],
 " \[LongDash] happy to merge."
}], "Text",ExpressionUUID->"96cffa3f-eaea-4f24-a111-b16b02cea1c8"]
},
Saveable->True,
